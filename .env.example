# === LLM ===
RAG_LLM_PROVIDER=groq          # groq | ollama | vllm
RAG_LLM_MODEL=llama-3.3-70b-versatile
RAG_LLM_BASE_URL=              # for ollama/vllm
RAG_LLM_CONTEXT_WINDOW=131072
GROQ_API_KEY=

# === Embedding ===
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DEVICE=cpu        # cpu | cuda

# === Qdrant ===
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_API_KEY=
RAG_DEFAULT_COLLECTION=default

# === Retrieval ===
RAG_TOP_K=15
RAG_RERANK_TOP_N=5
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_ENABLE_HYBRID=true
RAG_HYBRID_ALPHA=0.5
RAG_ENABLE_HYDE=false
RAG_RESPONSE_MODE=refine

# === Chunking ===
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=128

# === Cache ===
RAG_MODEL_CACHE_DIR=/app/models/huggingface
RAG_FASTEMBED_CACHE_DIR=/app/models/fastembed

# === Server ===
RAG_HOST=0.0.0.0
RAG_PORT=8000
RAG_LOG_LEVEL=info
